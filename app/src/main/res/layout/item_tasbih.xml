<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="7dp"
    card_view:cardCornerRadius="20dp"
    card_view:cardElevation="6dp"
    card_view:cardBackgroundColor="#00000000">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tasbih_card_item"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp"
        android:layoutDirection="ltr">

        <!-- Reorder Actions (Left Side) -->
        <LinearLayout
            android:id="@+id/llReorder"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_reorder_container"
            android:paddingVertical="4dp"
            android:layout_marginRight="14dp">

            <ImageView
                android:id="@+id/btnMoveUp"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@drawable/ic_chevron_up"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"/>

            <ImageView
                android:id="@+id/btnMoveDown"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@drawable/ic_chevron_down"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"/>
        </LinearLayout>

        <!-- Counter Bubble (Right Side) -->
        <FrameLayout
            android:id="@+id/tvCountContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_count_premium_pill">

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="33"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#F59E0B"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"/>
        </FrameLayout>

        <!-- Tasbih Text & Content Details (Center Container) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/llReorder"
            android:layout_toLeftOf="@id/tvCountContainer"
            android:layout_marginRight="12dp"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <!-- Tasbih Name -->
            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tasbih Name"
                android:textSize="19sp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/sakkal"
                android:maxLines="1"
                android:ellipsize="end"
                android:textDirection="locale"/>

            <!-- Tasbih Words / Content Preview -->
            <TextView
                android:id="@+id/tvContentPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Arabic Content"
                android:textSize="14sp"
                android:textColor="#94A3B8"
                android:fontFamily="@font/sakkal"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"/>
        </LinearLayout>
    </RelativeLayout>

</androidx.cardview.widget.CardView>
