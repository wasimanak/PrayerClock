<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="4dp"
    card_view:cardBackgroundColor="#1A1A3A">

    <!-- Force LTR so layout elements remain predictable -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:layoutDirection="ltr">

        <!-- Reorder Arrows Container (Left Side) -->
        <LinearLayout
            android:id="@+id/llReorder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginRight="12dp">

            <TextView
                android:id="@+id/btnMoveUp"
                android:layout_width="34dp"
                android:layout_height="28dp"
                android:text="▲"
                android:textColor="#F59E0B"
                android:textSize="14sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"/>

            <TextView
                android:id="@+id/btnMoveDown"
                android:layout_width="34dp"
                android:layout_height="28dp"
                android:text="▼"
                android:textColor="#F59E0B"
                android:textSize="14sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:clickable="true"/>
        </LinearLayout>

        <!-- Tasbih Name -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/llReorder"
            android:layout_toLeftOf="@+id/tvCountContainer"
            android:layout_marginRight="12dp"
            android:layout_centerVertical="true"
            android:text="Tasbih Name"
            android:textSize="19sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/sakkal"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="left|center_vertical"
            android:textDirection="locale"/>

        <!-- Counter Bubble (Right Side) -->
        <FrameLayout
            android:id="@+id/tvCountContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_count_premium_pill">

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="33"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"/>
        </FrameLayout>
    </RelativeLayout>

</androidx.cardview.widget.CardView>
