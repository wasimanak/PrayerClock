<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="#161828"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp"
    app:strokeColor="#30F59E0B"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Accent Indicator -->
        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_count_premium_pill" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sakkal"
            android:gravity="center"
            android:text="Search Location"
            android:textColor="#F59E0B"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="Type city name to see live matching results"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Single Line Search Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="City Name (شہر کا نام)"
            app:hintTextColor="#F59E0B"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#F59E0B"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:placeholderText="e.g. Lahore, Karachi, Islamabad"
            app:placeholderTextColor="#4DFFFFFF"
            android:textColorHint="#94A3B8"
            app:endIconMode="clear_text"
            app:endIconTint="#94A3B8">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearchQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sakkal"
                android:inputType="text"
                android:singleLine="true"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:padding="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Live City Suggestions List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCitySuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="Cancel"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="Search"
                android:textColor="#161828"
                android:textStyle="bold"
                android:backgroundTint="#F59E0B"
                app:cornerRadius="16dp"
                android:textSize="14sp"
                android:paddingHorizontal="24dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
